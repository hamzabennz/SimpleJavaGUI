DATABASE_URL="postgresql://postgres:postgres@localhost:5432/souk"
# Secret used to sign admin session cookies
SESSION_SECRET="change-me-to-a-long-random-string"
# Root domain of the SaaS. Stores are served at <slug>.<ROOT_DOMAIN>
ROOT_DOMAIN="localhost:3000"
# Store used when the host does not match any tenant (handy in dev)
DEFAULT_TENANT="demo"
SECRETS_KEY="change-me-32-chars-minimum-random-string"
